{
  "name": "@rasql/driver-mysql",
  "version": "0.1.0",
  "description": "RaSQL MySQL and MariaDB driver on mysql2, with flavor detection",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rasql/driver-protocol": "workspace:*",
    "@rasql/driver-sdk": "workspace:*",
    "mysql2": "^3.24.5"
  }
}
