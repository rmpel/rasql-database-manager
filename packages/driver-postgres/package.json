{
  "name": "@rasql/driver-postgres",
  "version": "0.1.0",
  "description": "RaSQL PostgreSQL driver on pg",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rasql/driver-protocol": "workspace:*",
    "@rasql/driver-sdk": "workspace:*",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2"
  }
}
