{
  "name": "@rasql/app",
  "productName": "RaSQL",
  "version": "0.1.0",
  "description": "RaSQL: a fast, keyboard-first database manager for web developers",
  "license": "GPL-3.0-or-later",
  "private": true,
  "author": "Remon Pel",
  "homepage": "https://github.com/rmpel/rasql-database-manager",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm --filter @rasql/localwp-addon build && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "test:e2e": "electron-vite build && playwright test",
    "predev": "pnpm --filter @rasql/localwp-addon build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@napi-rs/keyring": "^2.1.0",
    "@rasql/driver-mysql": "workspace:*",
    "@rasql/driver-protocol": "workspace:*",
    "@rasql/driver-sdk": "workspace:*",
    "@rasql/driver-sqlite": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.64.0",
    "@rasql/localwp-addon": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "sass-embedded": "^1.105.1",
    "vite": "^7.3.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring-darwin-arm64": "^2.1.0",
    "@napi-rs/keyring-darwin-x64": "^2.1.0",
    "@napi-rs/keyring-linux-arm64-gnu": "^2.1.0",
    "@napi-rs/keyring-linux-x64-gnu": "^2.1.0",
    "@napi-rs/keyring-win32-arm64-msvc": "^2.1.0",
    "@napi-rs/keyring-win32-x64-msvc": "^2.1.0"
  }
}
