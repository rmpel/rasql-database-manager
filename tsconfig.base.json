{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@rasql/driver-protocol": ["./packages/driver-protocol/src/index.ts"],
      "@rasql/driver-sdk": ["./packages/driver-sdk/src/index.ts"],
      "@rasql/driver-sqlite": ["./packages/driver-sqlite/src/index.ts"],
      "@rasql/driver-mysql": ["./packages/driver-mysql/src/index.ts"],
      "@shared/*": ["./packages/app/src/shared/*"],
      "@rasql/localwp-addon": ["./packages/localwp-addon/src/index.ts"]
    }
  }
}
